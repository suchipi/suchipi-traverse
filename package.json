{
  "name": "@suchipi/traverse",
  "version": "5.1.1",
  "description": "Basic depth-first traversal function",
  "main": "./dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "keywords": [
    "traverse",
    "tree",
    "leaf",
    "node",
    "depth",
    "traversal",
    "iterate",
    "all"
  ],
  "author": "Lily Skye <me@suchipi.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suchipi/suchipi-traverse.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json && echo '{\"type\":\"module\"}' > dist/esm/package.json && rm -rf dist/**/*.{type-,}test.*",
    "test": "tsc --noEmit && vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "prettier": {}
}
